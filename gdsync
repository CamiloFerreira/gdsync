#!/usr/bin/env bash
# gdsync - Sincroniza UNA carpeta de Google Drive con una carpeta local (bidireccional)
# Basado en rclone bisync + systemd --user timer.
set -euo pipefail

APP=gdsync
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$APP"
CONFIG_FILE="$CONFIG_DIR/config"
FILTERS_FILE="$CONFIG_DIR/filters.txt"
LOG_FILE="$STATE_DIR/sync.log"
BIN_DIR="$HOME/.local/bin"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
RCLONE_MIN="1.66.0"
SELF="$(readlink -f "$0")"
SELF_DIR="$(dirname "$SELF")"
VERSION="$(cat "$SELF_DIR/VERSION" 2>/dev/null || echo 0.0.0)"
UPDATE_URL="https://github.com/CamiloFerreira/gdsync/releases/latest/download/update.json"
UPDATE_CACHE="$STATE_DIR/update.json"

# Valores por defecto (se sobreescriben con $CONFIG_FILE)
REMOTE_NAME="gdrive"
REMOTE_PATH=""
LOCAL_PATH=""
INTERVAL="5min"

export PATH="$BIN_DIR:$PATH"

info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()   { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

load_config() { [[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"; return 0; }

save_config() {
  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" <<EOF
REMOTE_NAME=$(printf '%q' "$REMOTE_NAME")
REMOTE_PATH=$(printf '%q' "$REMOTE_PATH")
LOCAL_PATH=$(printf '%q' "$LOCAL_PATH")
INTERVAL=$(printf '%q' "$INTERVAL")
EOF
  info "Config guardada en $CONFIG_FILE"
}

ensure_filters() {
  mkdir -p "$CONFIG_DIR"
  [[ -f "$FILTERS_FILE" ]] && return 0
  cat > "$FILTERS_FILE" <<'EOF'
# Reglas de exclusión rclone (https://rclone.org/filtering/)
- .~lock.*
- ~$*
- *.tmp
- *.swp
- .DS_Store
- Thumbs.db
- desktop.ini
- .Trash-*/**
EOF
}

version_ge() { [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" == "$2" ]]; }

rclone_version() { rclone version 2>/dev/null | head -1 | sed -E 's/^rclone v?([0-9.]+).*/\1/'; }

# ---------------------------------------------------------------- comandos

cmd_install_rclone() {
  if command -v rclone >/dev/null && version_ge "$(rclone_version)" "$RCLONE_MIN"; then
    info "rclone $(rclone_version) ya instalado ($(command -v rclone))"
    return 0
  fi
  info "Instalando rclone (última versión) en $BIN_DIR sin sudo..."
  command -v curl >/dev/null || die "Falta curl: sudo apt install curl"
  command -v unzip >/dev/null || die "Falta unzip: sudo apt install unzip"
  local arch
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    armv7l) arch=arm-v7 ;;
    *) die "Arquitectura no soportada: $(uname -m)" ;;
  esac
  local tmp; tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  curl -fsSL -o "$tmp/rclone.zip" "https://downloads.rclone.org/rclone-current-linux-$arch.zip"
  unzip -q "$tmp/rclone.zip" -d "$tmp"
  mkdir -p "$BIN_DIR"
  install -m 755 "$tmp"/rclone-*-linux-"$arch"/rclone "$BIN_DIR/rclone"
  info "rclone $(rclone_version) instalado en $BIN_DIR/rclone"
}

cmd_auth() {
  load_config
  if rclone listremotes 2>/dev/null | grep -qx "$REMOTE_NAME:"; then
    info "Remote '$REMOTE_NAME' ya existe. Para rehacerlo: rclone config delete $REMOTE_NAME"
    return 0
  fi
  info "Se abrirá el navegador para autorizar Google Drive..."
  rclone config create "$REMOTE_NAME" drive scope=drive
  rclone about "$REMOTE_NAME:" >/dev/null && info "Autenticación OK"
}

cmd_choose() {
  load_config
  rclone listremotes | grep -qx "$REMOTE_NAME:" || die "No hay remote '$REMOTE_NAME'. Ejecuta: $APP auth"

  local cur="" choice
  local -a dirs
  local ans=""
  while true; do
    echo
    info "Drive: /${cur}"
    mapfile -t dirs < <(rclone lsf "$REMOTE_NAME:$cur" --dirs-only --drive-skip-gdocs 2>/dev/null | sed 's:/$::')
    local -a opts=("[✔ Elegir esta carpeta]")
    [[ -n "$cur" ]] && opts+=("[.. Subir]")
    opts+=("${dirs[@]}")
    PS3="Número: "
    select choice in "${opts[@]}"; do
      [[ -n "${choice:-}" ]] && break
      warn "Opción inválida"
    done
    [[ -n "${choice:-}" ]] || die "Cancelado"
    case "$choice" in
      "[✔ Elegir esta carpeta]")
        [[ -z "$cur" ]] && { warn "Elige una subcarpeta, no la raíz entera"; continue; }
        break ;;
      "[.. Subir]")
        [[ "$cur" == */* ]] && cur="${cur%/*}" || cur="" ;;
      *)
        cur="${cur:+$cur/}$choice" ;;
    esac
  done

  REMOTE_PATH="$cur"
  local default_local="$HOME/GoogleDrive/${cur##*/}"
  read -r -p "Carpeta local [$default_local]: " LOCAL_PATH
  LOCAL_PATH="${LOCAL_PATH:-$default_local}"
  LOCAL_PATH="${LOCAL_PATH/#\~/$HOME}"
  mkdir -p "$LOCAL_PATH"

  read -r -p "Intervalo de sync (systemd, ej 2min, 10min, 1h) [$INTERVAL]: " ans
  INTERVAL="${ans:-$INTERVAL}"

  save_config
  info "Drive:/$REMOTE_PATH  <->  $LOCAL_PATH  (cada $INTERVAL)"
  info "La próxima sincronización hará un --resync inicial."
  rm -rf "$STATE_DIR/bisync"   # fuerza resync al cambiar de carpeta
}

bisync() {
  load_config
  [[ -n "$REMOTE_PATH" && -n "$LOCAL_PATH" ]] || die "Sin carpeta configurada. Ejecuta: $APP choose"
  ensure_filters
  mkdir -p "$STATE_DIR/bisync" "$LOCAL_PATH"
  rclone bisync "$REMOTE_NAME:$REMOTE_PATH" "$LOCAL_PATH" \
    --workdir "$STATE_DIR/bisync" \
    --filters-file "$FILTERS_FILE" \
    --create-empty-src-dirs \
    --compare size,modtime \
    --resilient --recover \
    --max-lock 5m \
    --conflict-resolve newer --conflict-loser num \
    --drive-skip-gdocs \
    --log-file "$LOG_FILE" --log-level INFO \
    "$@"
}

# Bloquea la sincronización si esta versión tiene una vulnerabilidad conocida
# (min_supported del último release > VERSION). Consulta como mucho cada 6 h.
security_gate() {
  mkdir -p "$STATE_DIR"
  local age=999999
  [[ -f "$UPDATE_CACHE" ]] && age=$(( $(date +%s) - $(stat -c %Y "$UPDATE_CACHE") ))
  if (( age > 21600 )) && command -v curl >/dev/null; then
    if curl -fsSL --max-time 8 -o "$UPDATE_CACHE.tmp" "$UPDATE_URL" 2>/dev/null; then
      mv -f "$UPDATE_CACHE.tmp" "$UPDATE_CACHE"
    else
      rm -f "$UPDATE_CACHE.tmp"
    fi
  fi
  [[ -f "$UPDATE_CACHE" && "$VERSION" != "0.0.0" ]] || return 0
  local min
  min="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("min_supported","0.0.0"))' "$UPDATE_CACHE" 2>/dev/null)" || return 0
  if ! version_ge "$VERSION" "$min"; then
    local msg="gdsync $VERSION tiene una vulnerabilidad conocida. Actualiza a $min o superior para seguir sincronizando."
    printf '%s ERROR : %s\n' "$(date '+%Y/%m/%d %H:%M:%S')" "$msg" >> "$LOG_FILE"
    command -v notify-send >/dev/null && notify-send -u critical -i io.github.gdsync "Actualización de seguridad obligatoria" "$msg" 2>/dev/null || true
    die "$msg"
  fi
}

cmd_sync() {
  mkdir -p "$STATE_DIR"
  security_gate
  local -a extra=()
  # Primer sync (o tras cambiar carpeta / filtros): necesita --resync
  if ! compgen -G "$STATE_DIR/bisync/*.lst" >/dev/null; then
    info "Primer sync: --resync (une ambos lados, no borra nada)"
    extra+=(--resync)
  fi
  if bisync "${extra[@]}" "$@"; then
    info "Sync OK ($(date '+%F %T'))"
  else
    local rc=$?
    warn "Sync falló (código $rc). Revisa: $APP logs"
    warn "Si pide resync: $APP resync"
    exit "$rc"
  fi
}

cmd_resync() { mkdir -p "$STATE_DIR"; security_gate; bisync --resync "$@"; info "Resync OK"; }

cmd_dry_run() { mkdir -p "$STATE_DIR"; LOG_FILE=/dev/stderr; bisync --dry-run "$@"; }

cmd_enable() {
  load_config
  [[ -n "$REMOTE_PATH" ]] || die "Sin carpeta configurada. Ejecuta: $APP choose"
  mkdir -p "$BIN_DIR" "$UNIT_DIR"
  # Ruta estable para systemd. Dentro de un AppImage el script vive en un
  # montaje temporal: se copia a ~/.local/share/gdsync/cli.
  local cli="$SELF"
  if [[ -n "${APPIMAGE:-}" || "$SELF" == /tmp/.mount_* ]]; then
    local dest="$HOME/.local/share/$APP/cli"
    mkdir -p "$dest"
    install -m 755 "$SELF" "$dest/gdsync"
    install -m 644 "$SELF_DIR/VERSION" "$dest/VERSION" 2>/dev/null || true
    cli="$dest/gdsync"
  fi
  # Enlace de conveniencia en ~/.local/bin si no hay gdsync del sistema
  if [[ "$cli" != /usr/* && ! -e /usr/bin/$APP ]]; then
    ln -sfn "$cli" "$BIN_DIR/$APP"
  fi

  cat > "$UNIT_DIR/$APP.service" <<EOF
[Unit]
Description=Sincronización Google Drive ($REMOTE_PATH)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=$BIN_DIR:/usr/local/bin:/usr/bin:/bin
ExecStart=$cli sync
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
EOF

  cat > "$UNIT_DIR/$APP.timer" <<EOF
[Unit]
Description=Ejecuta $APP periódicamente

[Timer]
OnStartupSec=1min
OnUnitInactiveSec=$INTERVAL

[Install]
WantedBy=timers.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable --now "$APP.timer"
  info "Timer activo. Sincroniza al iniciar sesión y cada $INTERVAL."
  info "Opcional (sync aunque no hayas iniciado sesión): sudo loginctl enable-linger $USER"
}

cmd_disable() {
  systemctl --user disable --now "$APP.timer" 2>/dev/null || true
  info "Timer desactivado"
}

cmd_status() {
  load_config
  echo "Remote : $REMOTE_NAME:$REMOTE_PATH"
  echo "Local  : $LOCAL_PATH"
  echo "Cada   : $INTERVAL"
  echo
  systemctl --user list-timers "$APP.timer" --no-pager 2>/dev/null || true
  echo
  systemctl --user status "$APP.service" --no-pager -n 5 2>/dev/null || true
}

cmd_logs() { [[ -f "$LOG_FILE" ]] && tail -n "${1:-50}" "$LOG_FILE" || warn "Sin logs aún"; }

APP_ID="io.github.gdsync"

cmd_ui() {
  [[ -d "$SELF_DIR/gdsync_app" ]] || die "No encuentro la app ($SELF_DIR/gdsync_app)"
  PYTHONPATH="$SELF_DIR${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m gdsync_app "$@"
}

cmd_desktop() {
  # Instala la app en ~/.local/share/gdsync + lanzador en el menú + icono.
  local src; src="$(dirname "$(readlink -f "$0")")"
  [[ -d "$src/gdsync_app" ]] || die "Ejecuta esto desde la carpeta del proyecto"
  python3 -c 'import gi; gi.require_version("Adw","1"); gi.require_version("Gtk","4.0")' 2>/dev/null \
    || die "Faltan GTK4/libadwaita: sudo apt install python3-gi gir1.2-adw-1"
  local share="$HOME/.local/share/$APP"
  mkdir -p "$share" "$BIN_DIR" "$HOME/.local/share/applications" "$HOME/.local/share/icons/hicolor/scalable/apps"
  if [[ "$(readlink -f "$src")" != "$(readlink -f "$share")" ]]; then
    rm -rf "$share/gdsync_app" "$share/data"
    cp -r "$src/gdsync_app" "$src/data" "$share/"
    find "$share/gdsync_app" -name '__pycache__' -prune -exec rm -rf {} +
    install -m 755 "$src/gdsync" "$share/gdsync"
    install -m 755 "$src/gdsync-desktop" "$share/gdsync-desktop"
    install -m 644 "$src/VERSION" "$share/VERSION"
  fi
  rm -f "$BIN_DIR/$APP" "$BIN_DIR/$APP-desktop"
  ln -s "$share/gdsync" "$BIN_DIR/$APP"
  ln -s "$share/gdsync-desktop" "$BIN_DIR/$APP-desktop"
  cp "$share/data/icons/hicolor/scalable/apps/$APP_ID.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/"
  cat > "$HOME/.local/share/applications/$APP_ID.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=Google Drive Sync
GenericName=Sincronización de Google Drive
Comment=Mantén una carpeta de Google Drive sincronizada con tu equipo
Exec=$BIN_DIR/$APP-desktop
Icon=$APP_ID
Terminal=false
StartupNotify=true
DBusActivatable=false
Categories=Network;FileTransfer;Utility;GTK;GNOME;
Keywords=google;drive;sync;rclone;nube;cloud;
DESK
  gtk-update-icon-cache -q -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
  update-desktop-database -q "$HOME/.local/share/applications" 2>/dev/null || true
  # Si el autostart existe, apuntarlo al lanzador instalado
  local auto="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/$APP.desktop"
  [[ -f "$auto" ]] && sed -i "s|^Exec=.*|Exec=$BIN_DIR/$APP-desktop --background|" "$auto"
  info "App instalada: busca «Google Drive Sync» en tus aplicaciones."
}

cmd_uninstall() {
  cmd_disable
  rm -f "$UNIT_DIR/$APP.service" "$UNIT_DIR/$APP.timer" "$BIN_DIR/$APP" "$BIN_DIR/$APP-desktop" \
        "$HOME/.local/share/applications/$APP_ID.desktop" \
        "$HOME/.local/share/icons/hicolor/scalable/apps/$APP_ID.svg" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/$APP.desktop"
  rm -rf "$HOME/.local/share/$APP"
  systemctl --user daemon-reload
  rm -rf "$STATE_DIR"
  info "Desinstalado. Conservados: config ($CONFIG_DIR), remote rclone y tus archivos locales."
}

cmd_setup() {
  cmd_install_rclone
  cmd_auth
  cmd_choose
  cmd_sync
  cmd_enable
  echo
  info "Listo. Comandos útiles: $APP status | $APP sync | $APP logs"
}

usage() {
  cat <<EOF
Uso: $APP <comando>

  setup           Todo en uno: instala rclone, autentica, eliges carpeta, sync y activa timer
  install-rclone  Instala/actualiza rclone en ~/.local/bin
  auth            Autoriza tu cuenta Google Drive (navegador)
  choose          Navega Drive y elige LA carpeta a sincronizar
  sync            Sincroniza ahora (bidireccional)
  dry-run         Muestra qué haría sync sin tocar nada
  resync          Fuerza resincronización completa (si bisync lo pide)
  enable          Activa sync automático persistente (systemd --user timer)
  disable         Desactiva sync automático
  status          Estado y próxima ejecución
  logs [N]        Últimas N líneas del log (def. 50)
  version         Muestra la versión
  ui              Abre la app de escritorio
  desktop         Instala la app en el menú de aplicaciones
  uninstall       Quita timer y binario (no borra tus archivos)

Config: $CONFIG_FILE
Filtros: $FILTERS_FILE
EOF
}

case "${1:-}" in
  setup)          shift; cmd_setup "$@" ;;
  install-rclone) shift; cmd_install_rclone "$@" ;;
  auth)           shift; cmd_auth "$@" ;;
  choose)         shift; cmd_choose "$@" ;;
  sync)           shift; cmd_sync "$@" ;;
  dry-run)        shift; cmd_dry_run "$@" ;;
  resync)         shift; cmd_resync "$@" ;;
  enable)         shift; cmd_enable "$@" ;;
  disable)        shift; cmd_disable "$@" ;;
  status)         shift; cmd_status "$@" ;;
  logs)           shift; cmd_logs "$@" ;;
  ui)             shift; cmd_ui "$@" ;;
  version|-V|--version) echo "gdsync $VERSION" ;;
  desktop)        shift; cmd_desktop "$@" ;;
  uninstall)      shift; cmd_uninstall "$@" ;;
  *)              usage ;;
esac
